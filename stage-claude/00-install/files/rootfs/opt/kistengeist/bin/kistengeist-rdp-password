#!/bin/bash
# Ändert das Passwort für den Fernzugriff:
#  - Browser-Zugang (Selkies): Passwort in ~/.config/kistengeist/selkies.env, Dienst wird neu gestartet
#  - RDP-Spiegelung (Zugangsart "beides" mit RDP): VNC-Passwort (nur die ersten 8 Zeichen zählen)
# Hinweis: "passwd" ändert nur das Anmeldepasswort, nicht dieses.
set -eu

env_file="$HOME/.config/kistengeist/selkies.env"
vnc_file="$HOME/.config/kistengeist/vnc.passwd"

read -rsp "Neues Passwort für den Fernzugriff: " pw1; echo
read -rsp "Wiederholen: " pw2; echo
[ "$pw1" = "$pw2" ] || { echo "Die Passwörter stimmen nicht überein." >&2; exit 1; }
[ "${#pw1}" -ge 8 ] || { echo "Bitte mindestens 8 Zeichen." >&2; exit 1; }

mkdir -p "$(dirname "$env_file")"
umask 077
if [ -f "$env_file" ]; then
    PW="$pw1" python3 - "$env_file" <<'PY'
import os, sys
esc = os.environ["PW"].replace("\\", "\\\\").replace('"', '\\"')
fd = os.open(sys.argv[1], os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w", encoding="utf-8") as fh:
    fh.write(f'SELKIES_BASIC_AUTH_PASSWORD="{esc}"\n')
PY
    systemctl --user restart kistengeist-selkies.service 2>/dev/null || true
    echo "Gespeichert. Im Browser gilt ab sofort das neue Passwort."
elif [ -f "$vnc_file" ]; then
    command -v vncpasswd >/dev/null || { echo "vncpasswd fehlt (Paket tigervnc-tools)." >&2; exit 1; }
    printf '%s\n' "$pw1" | vncpasswd -f >"$vnc_file"
    pkill -u "$USER" -x x11vnc || true
    echo "Gespeichert. Die Spiegelung startet mit der nächsten Anmeldung am Pi (oder jetzt neu anmelden)."
else
    echo "Kein Fernzugriff mit eigenem Passwort eingerichtet (RDP nutzt das Anmeldepasswort)." >&2
    exit 1
fi
