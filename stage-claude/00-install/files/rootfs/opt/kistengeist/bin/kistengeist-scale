#!/bin/bash
# Schriftgröße der Kistengeist-Oberfläche wählen (bei der ersten Anmeldung und über das Ausschalten-Menü).
#   kistengeist-scale            Auswahl zeigen, anwenden, Leiste neu laden, Mauszeiger anpassen, Neustart von Claude Desktop anbieten
#   kistengeist-scale --first    nur, wenn noch nie gewählt (vor dem Start von Claude Desktop, ohne Neustart)
set -u
lib=/opt/kistengeist/lib/kistengeist_scale.py
current="$(python3 "$lib" get)"
if [ "${1:-}" = "--first" ] && [ -n "$current" ]; then
    exit 0
fi
cur="${current:-100}"
rows=()
for s in 100 125 150 175 200; do
    hint=""
    case "$s" in
        100) hint="Normal" ;;
        150) hint="Gut für große Bildschirme" ;;
        200) hint="Für 4K bzw. sehr hohe RDP-Auflösung" ;;
    esac
    rows+=("$([ "$s" = "$cur" ] && echo TRUE || echo FALSE)" "$s %" "$hint")
done
choice="$(zenity --list --radiolist --title "Schriftgröße" \
    --text "Wie groß sollen Schrift, Symbole und Leiste sein?\nÄndern kannst du das später über Ausschalten, Eintrag Schriftgröße." \
    --column "" --column "Größe" --column "" "${rows[@]}" --width 460 --height 380 --timeout 120 2>/dev/null)"
choice="${choice%% %}"
case "$choice" in
    100 | 125 | 150 | 175 | 200) ;;
    *)
        # Abgebrochen: bei der ersten Anmeldung trotzdem merken (100 %), damit nicht jedes Mal gefragt wird.
        [ -z "$current" ] && python3 "$lib" set 100 && xrdb -merge "$HOME/.Xresources" 2>/dev/null
        exit 0
        ;;
esac
python3 "$lib" set "$choice"
xrdb -merge "$HOME/.Xresources" 2>/dev/null || true
# Mauszeiger sofort in der neuen Größe: Umgebung für alles, was ab jetzt startet, und den
# Zeiger auf dem Hintergrund neu setzen.
eval "$(python3 "$lib" env 2>/dev/null)"
export XCURSOR_THEME XCURSOR_SIZE
dbus-update-activation-environment --systemd XCURSOR_THEME XCURSOR_SIZE 2>/dev/null \
    || dbus-update-activation-environment XCURSOR_THEME XCURSOR_SIZE 2>/dev/null || true
xsetroot -cursor_name left_ptr 2>/dev/null || true
[ "${1:-}" = "--first" ] && exit 0

# Leiste mit neuer Größe neu starten
/opt/kistengeist/bin/kistengeist-autostart --panel-only
if zenity --question --title "Schriftgröße" --width 380 \
    --text "Leiste und Mauszeiger haben die neue Größe. Claude Desktop und bereits geöffnete Programme übernehmen sie nach einem Neustart. Claude Desktop jetzt neu starten?" 2>/dev/null; then
    # Nur eigene Prozesse; die Startschleife in kistengeist-autostart startet Claude gleich wieder.
    pkill -u "$(id -u)" -f '(^|/)claude-desktop( |$)' 2>/dev/null || true
fi
