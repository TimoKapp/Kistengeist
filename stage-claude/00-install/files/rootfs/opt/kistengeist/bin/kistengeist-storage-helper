#!/bin/bash
# Führt fest definierte Aufräumaktionen als root aus (per sudo von der
# Speicherverwaltung aufgerufen). Andere Argumente werden abgelehnt.
set -eu

case "${1:-}" in
    clean-apt)
        apt-get clean
        apt-get autoclean
        ;;
    vacuum-journal)
        journalctl --vacuum-size=32M
        ;;
    *)
        echo "Erlaubt: clean-apt | vacuum-journal" >&2
        exit 2
        ;;
esac
