#!/bin/bash
# Gibt den Einrichtungscode dieses Geräts aus (legt ihn beim ersten Aufruf an).
# 10 Zeichen ohne verwechselbare Zeichen; zugleich Passwort des Einrichtungs-WLANs.
# Vorrang hat ein Code, den das Windows-Werkzeug per cloud-init nach /etc/kistengeist gelegt hat.
set -euo pipefail
dir="${KG_ETC:-/etc/kistengeist}"
file="$dir/setup-code"
boot="${KG_BOOT_CODE:-/boot/firmware/kistengeist-code.txt}"
valid() { [[ "$1" =~ ^[ABCDEFGHJKMNPQRSTUVWXYZ23456789]{10}$ ]]; }
mkdir -p "$dir"
exec 9>"$file.lock"
flock 9
code="$(tr -d '[:space:]' 2>/dev/null <"$file" || true)"
if ! valid "$code"; then
    code="$(tr -d '[:space:]' 2>/dev/null <"$boot" | tr '[:lower:]' '[:upper:]' || true)"
    if ! valid "$code"; then
        code="$(python3 -c 'import secrets; print("".join(secrets.choice("ABCDEFGHJKMNPQRSTUVWXYZ23456789") for _ in range(10)))')"
    fi
    valid "$code" || { echo "Einrichtungscode konnte nicht erzeugt werden." >&2; exit 1; }
    tmp="$(mktemp "$file.XXXXXX")"
    printf '%s\n' "$code" >"$tmp"
    chmod 0600 "$tmp"
    mv -f "$tmp" "$file"
fi
chmod 0600 "$file"
printf '%s\n' "$code"
