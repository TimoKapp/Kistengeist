#!/usr/bin/env python3
"""Zeigt die rechtlichen Hinweise, den KI-Hinweis und die Datenschutzinformationen an."""

import os
import subprocess
import sys
import tempfile

sys.path.insert(0, "/opt/kistengeist/lib")
import kistengeist_legal as legal  # noqa: E402

data = legal.load()
fd, path = tempfile.mkstemp(prefix="kistengeist-rechtliches-", suffix=".html")
with os.fdopen(fd, "w", encoding="utf-8") as fh:
    fh.write(legal.to_html(data))
browser = (open("/etc/kistengeist/browser").read().strip() if os.path.exists("/etc/kistengeist/browser") else "")
for cmd in ([browser, "--password-store=gnome-libsecret", "--new-window", path] if browser else None,
            ["xdg-open", path]):
    if cmd:
        try:
            subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            sys.exit(0)
        except OSError:
            continue
subprocess.call(["zenity", "--text-info", "--width", "760", "--height", "640",
                 "--title", data["title"], "--filename", path])
